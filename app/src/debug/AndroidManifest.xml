<?xml version="1.0" encoding="utf-8"?>
<!-- Debug builds only (never in the release APK): a test notification with buttons and a reply
     field, to try the notification column without touching real conversations. Only the shell
     (adb) can trigger it: DUMP is a permission ordinary apps cannot get. -->
<manifest xmlns:android="http://schemas.android.com/apk/res/android">

    <uses-permission android:name="android.permission.POST_NOTIFICATIONS" />

    <application>
        <receiver
            android:name="cu.axel.smartdock.debug.TestNotificationReceiver"
            android:exported="true"
            android:permission="android.permission.DUMP" />
    </application>
</manifest>
