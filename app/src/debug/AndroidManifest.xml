<?xml version="1.0" encoding="utf-8"?>
<!-- Debug-only phase 0 spikes (docs/PLAN.md). Merged only into debug builds; delete after phase 0. -->
<manifest xmlns:android="http://schemas.android.com/apk/res/android">

    <application>
        <activity
            android:name="cu.axel.smartdock.spikes.SpikeActivity"
            android:exported="true"
            android:label="@string/spike_activity_label">
            <intent-filter>
                <action android:name="android.intent.action.MAIN" />

                <category android:name="android.intent.category.LAUNCHER" />
            </intent-filter>
        </activity>

        <!-- Spike (g): portrait-only screen. Exported only so adb can start it; it reads no extras. -->
        <activity
            android:name="cu.axel.smartdock.spikes.PortraitSpikeActivity"
            android:exported="true"
            android:label="EG Vertical"
            android:screenOrientation="portrait" />

        <service
            android:name="cu.axel.smartdock.spikes.WindowTrackerSpikeService"
            android:exported="false"
            android:label="@string/spike_window_tracker_label"
            android:permission="android.permission.BIND_ACCESSIBILITY_SERVICE">
            <intent-filter>
                <action android:name="android.accessibilityservice.AccessibilityService" />
            </intent-filter>

            <meta-data
                android:name="android.accessibilityservice"
                android:resource="@xml/spike_window_tracker" />
        </service>
    </application>

</manifest>
