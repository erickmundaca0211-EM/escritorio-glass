    <string name="welcome_title">Welcome to Escritorio Glass</string>
    <string name="welcome_body">Use your phone like a PC: taskbar, Start menu, windows and a glass look.\n\nEscritorio Glass has no internet permission: nothing you do leaves your phone. A few steps give it the permissions it needs.</string>
    <string name="welcome_start">Start</string>
    <string name="welcome_overlay_title">Display over other apps</string>
    <string name="welcome_overlay_body">The taskbar, the Start menu and the panels are drawn on top of other apps. Find Escritorio Glass in the list and turn it on.</string>
    <string name="welcome_restricted_title">Allow restricted settings</string>
    <string name="welcome_restricted_body">Android guards accessibility for apps installed from an APK file. In the app info, tap ⋮ (More) and choose “Allow restricted settings”. Then come back here.</string>
    <string name="welcome_open_app_info">Open app info</string>
    <string name="welcome_accessibility_title">Turn on desktop mode</string>
    <string name="welcome_accessibility_body">Escritorio Glass uses the accessibility service to show the taskbar, know which windows are open and answer keyboard shortcuts. It never reads what your apps show or stores what you type.</string>
    <string name="welcome_activate">Turn on</string>
    <string name="welcome_accessibility_toast">Find Escritorio Glass, turn it on and come back</string>
    <string name="welcome_needs_overlay">First allow “Display over other apps”</string>
    <string name="welcome_extras_title">Optional</string>
    <string name="welcome_extras_body">They add features. Grant them now or later from “Manage permissions” in the settings.</string>
    <string name="welcome_notifications">Notifications</string>
    <string name="welcome_notifications_desc">See and dismiss them in the notification center</string>
    <string name="welcome_usage">App usage</string>
    <string name="welcome_usage_desc">Recent apps in Start and on the taskbar without Shizuku</string>
    <string name="welcome_calendar">Calendar</string>
    <string name="welcome_calendar_desc">Your next event next to the date on the taskbar</string>
    <string name="welcome_shizuku">Shizuku</string>
    <string name="welcome_shizuku_desc">Minimize and close windows, and keep the system shade closed</string>
    <string name="welcome_install">Install</string>
    <string name="welcome_open">Open</string>
    <string name="welcome_adb">Secure settings (with a PC)</string>
    <string name="welcome_adb_desc">Desktop scale, and desktop mode turned on from the app</string>
    <string name="welcome_copy_command">Copy command</string>
    <string name="welcome_command_copied">Command copied: run it on the PC with the phone connected</string>
    <string name="welcome_done_title">All set</string>
    <string name="welcome_done_body">Desktop mode is on. Change the glass, the taskbar and the scale anytime in Escritorio Glass settings.</string>
    <string name="welcome_go_desktop">Go to the desktop</string>
    <string name="welcome_missing_title">Almost there</string>
    <string name="welcome_missing_body">Without “Display over other apps” and desktop mode turned on, Escritorio Glass cannot work.</string>
