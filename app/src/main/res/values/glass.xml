<?xml version="1.0" encoding="utf-8"?>
<!-- Escritorio Glass design tokens (docs/DISENO.md). -->
<resources>
    <!-- Glass surface -->
    <color name="glass_tint">#121824</color>
    <color name="glass_border">#2EFFFFFF</color>          <!-- white 18 % -->
    <color name="glass_highlight_top">#5CFFFFFF</color>   <!-- white 36 % -->
    <color name="glass_specular">#29FFFFFF</color>        <!-- white 16 % -->

    <!-- Content on glass -->
    <color name="glass_text_primary">#FFFFFF</color>
    <color name="glass_text_secondary">#D9FFFFFF</color>  <!-- white 85 % -->
    <color name="glass_surface_hover">#1FFFFFFF</color>   <!-- white 12 % -->
    <color name="glass_surface_hover_soft">#14FFFFFF</color>   <!-- white 8 %: mouse over a button -->
    <color name="glass_surface_hover_strong">#29FFFFFF</color>   <!-- white 16 %: mouse over an active one -->
    <color name="glass_separator">#2EFFFFFF</color>
    <color name="glass_badge">#E6121824</color>   <!-- glass tint 90 %: small buttons over icons -->

    <!-- Accent -->
    <color name="accent_sky">#6CC4FF</color>
    <color name="accent_mint">#7FD1B9</color>
    <color name="accent_amber">#F2B66D</color>
    <color name="accent_lilac">#C4A1FF</color>
    <color name="on_accent">#0B1726</color>
    <color name="danger">#C42B1C</color>
    <color name="danger_pressed">#A3241A</color>

    <!-- Radii -->
    <dimen name="glass_radius_bar">18dp</dimen>
    <dimen name="glass_radius_menu">22dp</dimen>
    <dimen name="glass_radius_panel">20dp</dimen>
    <dimen name="glass_radius_popup">14dp</dimen>
    <dimen name="glass_radius_window">12dp</dimen>
    <dimen name="glass_radius_button">10dp</dimen>

    <!-- Defaults (also hard-coded in GlassSettings) -->
    <integer name="glass_tint_opacity_default">62</integer>
    <integer name="glass_blur_radius_default">24</integer>

    <item name="glass_attach_listener" type="id" />
    <item name="panel_animator" type="id" />
</resources>
