<?xml version="1.0" encoding="utf-8"?>
<!-- "Ancladas" cell of the Start menu (docs/mockup/Main.dc.html): 34 dp icon, 11.5 label, 10 dp corners. -->
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:layout_margin="2dp"
    android:background="@drawable/taskbar_button_bg"
    android:clickable="true"
    android:focusable="true"
    android:gravity="center_horizontal"
    android:orientation="vertical"
    android:paddingTop="6dp"
    android:paddingBottom="6dp">

    <ImageView
        android:id="@+id/app_icon_iv"
        android:layout_width="34dp"
        android:layout_height="34dp"
        android:importantForAccessibility="no" />

    <TextView
        android:id="@+id/app_name_tv"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginStart="2dp"
        android:layout_marginTop="5dp"
        android:layout_marginEnd="2dp"
        android:ellipsize="end"
        android:gravity="center_horizontal"
        android:singleLine="true"
        android:textColor="@color/glass_text_primary"
        android:textSize="11.5sp" />
</LinearLayout>
