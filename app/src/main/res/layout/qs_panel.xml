<?xml version="1.0" encoding="utf-8"?>
<!--
    Escritorio Glass quick settings (docs/DISENO.md, "Ajustes rápidos"; docs/mockup/QuickSettings.png).
    372 dp glass panel: 3 x 3 buttons, brightness / volume / scale sliders and a footer with the battery.
    The buttons are added by QuickSettingsPanel into the three rows.
-->
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:background="@drawable/round_rect"
    android:orientation="vertical">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="vertical"
        android:paddingStart="18dp"
        android:paddingTop="16dp"
        android:paddingEnd="18dp"
        android:paddingBottom="14dp">

        <LinearLayout
            android:id="@+id/qs_row_1"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="horizontal" />

        <LinearLayout
            android:id="@+id/qs_row_2"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="10dp"
            android:orientation="horizontal" />

        <LinearLayout
            android:id="@+id/qs_row_3"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="10dp"
            android:layout_marginBottom="8dp"
            android:orientation="horizontal" />

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="32dp"
            android:layout_marginTop="6dp"
            android:gravity="center_vertical"
            android:orientation="horizontal">

            <ImageView
                android:id="@+id/qs_brightness_icon"
                android:layout_width="20dp"
                android:layout_height="20dp"
                android:importantForAccessibility="no"
                android:src="@drawable/ic_eg_sun" />

            <SeekBar
                android:id="@+id/qs_brightness_seek"
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_marginStart="6dp"
                android:layout_weight="1"
                android:contentDescription="@string/qs_brightness" />

            <TextView
                android:id="@+id/qs_brightness_value"
                android:layout_width="42dp"
                android:layout_height="wrap_content"
                android:gravity="end"
                android:textColor="@color/glass_text_primary"
                android:textSize="12sp" />
        </LinearLayout>

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="32dp"
            android:layout_marginTop="6dp"
            android:gravity="center_vertical"
            android:orientation="horizontal">

            <ImageView
                android:id="@+id/qs_volume_icon"
                android:layout_width="20dp"
                android:layout_height="20dp"
                android:importantForAccessibility="no"
                android:src="@drawable/ic_eg_volume" />

            <SeekBar
                android:id="@+id/qs_volume_seek"
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_marginStart="6dp"
                android:layout_weight="1"
                android:contentDescription="@string/qs_volume" />

            <TextView
                android:id="@+id/qs_volume_value"
                android:layout_width="42dp"
                android:layout_height="wrap_content"
                android:gravity="end"
                android:textColor="@color/glass_text_primary"
                android:textSize="12sp" />
        </LinearLayout>

        <!-- Only during a phone or WhatsApp call -->
        <LinearLayout
            android:id="@+id/qs_call_row"
            android:layout_width="match_parent"
            android:layout_height="32dp"
            android:layout_marginTop="6dp"
            android:gravity="center_vertical"
            android:orientation="horizontal"
            android:visibility="gone">

            <ImageView
                android:id="@+id/qs_call_icon"
                android:layout_width="20dp"
                android:layout_height="20dp"
                android:importantForAccessibility="no"
                android:src="@drawable/ic_eg_call" />

            <SeekBar
                android:id="@+id/qs_call_seek"
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_marginStart="6dp"
                android:layout_weight="1"
                android:contentDescription="@string/qs_call_volume" />

            <TextView
                android:id="@+id/qs_call_value"
                android:layout_width="42dp"
                android:layout_height="wrap_content"
                android:gravity="end"
                android:textColor="@color/glass_text_primary"
                android:textSize="12sp" />
        </LinearLayout>

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="32dp"
            android:layout_marginTop="6dp"
            android:gravity="center_vertical"
            android:orientation="horizontal">

            <ImageView
                android:id="@+id/qs_scale_icon"
                android:layout_width="20dp"
                android:layout_height="20dp"
                android:importantForAccessibility="no"
                android:src="@drawable/ic_eg_zoom_out" />

            <SeekBar
                android:id="@+id/qs_scale_seek"
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_marginStart="6dp"
                android:layout_weight="1"
                android:contentDescription="@string/qs_scale" />

            <TextView
                android:id="@+id/qs_scale_value"
                android:layout_width="42dp"
                android:layout_height="wrap_content"
                android:gravity="end"
                android:textColor="@color/glass_text_primary"
                android:textSize="12sp" />
        </LinearLayout>
    </LinearLayout>

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="46dp"
        android:background="@drawable/qs_footer_bg"
        android:gravity="center_vertical"
        android:orientation="horizontal"
        android:paddingStart="18dp"
        android:paddingEnd="12dp">

        <ImageView
            android:id="@+id/qs_battery_icon"
            android:layout_width="20dp"
            android:layout_height="20dp"
            android:importantForAccessibility="no" />

        <TextView
            android:id="@+id/qs_battery_tv"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_marginStart="8dp"
            android:layout_weight="1"
            android:textColor="@color/glass_text_primary"
            android:textSize="12.5sp" />

        <ImageView
            android:id="@+id/qs_edit_btn"
            android:layout_width="44dp"
            android:layout_height="36dp"
            android:background="@drawable/taskbar_button_bg"
            android:contentDescription="@string/qs_edit"
            android:padding="9dp"
            android:src="@drawable/ic_eg_edit" />

        <ImageView
            android:id="@+id/qs_settings_btn"
            android:layout_width="44dp"
            android:layout_height="36dp"
            android:layout_marginStart="2dp"
            android:background="@drawable/taskbar_button_bg"
            android:contentDescription="@string/qs_settings"
            android:padding="9dp"
            android:src="@drawable/ic_eg_settings" />
    </LinearLayout>
</LinearLayout>
