<?xml version="1.0" encoding="utf-8"?>
<!-- Notification card of one app: icon, app name and time of the newest one, then its notifications. -->
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:layout_marginBottom="8dp"
    android:background="@drawable/notification_card_bg"
    android:orientation="vertical"
    android:paddingStart="12dp"
    android:paddingTop="9dp"
    android:paddingEnd="8dp"
    android:paddingBottom="9dp">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:gravity="center_vertical"
        android:orientation="horizontal">

        <ImageView
            android:id="@+id/group_icon"
            android:layout_width="18dp"
            android:layout_height="18dp"
            android:importantForAccessibility="no" />

        <TextView
            android:id="@+id/group_app"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_marginStart="8dp"
            android:layout_weight="1"
            android:singleLine="true"
            android:textColor="@color/glass_text_secondary"
            android:textSize="11.5sp" />

        <TextView
            android:id="@+id/group_time"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginEnd="4dp"
            android:textColor="@color/glass_text_secondary"
            android:textSize="11.5sp" />
    </LinearLayout>

    <LinearLayout
        android:id="@+id/group_items"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="vertical" />
</LinearLayout>
