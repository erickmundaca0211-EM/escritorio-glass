<?xml version="1.0" encoding="utf-8"?>
<!-- One notification inside its app card: title (13, 600), text (12) and a dismiss button, then the
     notification's own action buttons and, for "Responder", a reply field. -->
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:layout_marginTop="4dp"
    android:background="@drawable/taskbar_button_bg"
    android:clickable="true"
    android:focusable="true"
    android:orientation="vertical"
    android:paddingTop="2dp"
    android:paddingBottom="2dp">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:gravity="center_vertical"
        android:orientation="horizontal">

        <LinearLayout
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_weight="1"
            android:orientation="vertical">

            <TextView
                android:id="@+id/item_title"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:ellipsize="end"
                android:singleLine="true"
                android:textColor="@color/glass_text_primary"
                android:textFontWeight="600"
                android:textSize="13sp" />

            <TextView
                android:id="@+id/item_text"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="2dp"
                android:ellipsize="end"
                android:maxLines="2"
                android:textColor="@color/glass_text_secondary"
                android:textSize="12sp" />
        </LinearLayout>

        <ImageView
            android:id="@+id/item_dismiss"
            android:layout_width="28dp"
            android:layout_height="28dp"
            android:alpha="0.75"
            android:background="@drawable/taskbar_button_bg"
            android:contentDescription="@string/nc_dismiss"
            android:padding="7dp"
            android:src="@drawable/ic_close" />
    </LinearLayout>

    <!-- Filled in code with up to three buttons -->
    <LinearLayout
        android:id="@+id/item_actions"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="4dp"
        android:orientation="horizontal"
        android:visibility="gone" />

    <LinearLayout
        android:id="@+id/item_reply"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="6dp"
        android:layout_marginEnd="4dp"
        android:gravity="center_vertical"
        android:orientation="horizontal"
        android:visibility="gone">

        <EditText
            android:id="@+id/item_reply_text"
            android:layout_width="0dp"
            android:layout_height="34dp"
            android:layout_weight="1"
            android:background="@drawable/start_search_bg"
            android:hint="@string/nc_reply_hint"
            android:imeOptions="actionSend|flagNoExtractUi"
            android:importantForAutofill="no"
            android:inputType="textShortMessage|textCapSentences"
            android:paddingStart="12dp"
            android:paddingEnd="12dp"
            android:singleLine="true"
            android:textColor="@color/glass_text_primary"
            android:textColorHint="@color/glass_text_secondary"
            android:textSize="13sp" />

        <ImageView
            android:id="@+id/item_reply_send"
            android:layout_width="34dp"
            android:layout_height="34dp"
            android:layout_marginStart="6dp"
            android:background="@drawable/taskbar_button_bg"
            android:contentDescription="@string/nc_send"
            android:padding="8dp"
            android:src="@drawable/ic_eg_send" />
    </LinearLayout>
</LinearLayout>
