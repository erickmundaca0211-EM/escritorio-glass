<?xml version="1.0" encoding="utf-8"?>
<!-- "Recomendado" tile: 30 dp icon, app name (12.5, 500) and when it was used (11.5, secondary). -->
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:layout_margin="4dp"
    android:background="@drawable/start_tile_bg"
    android:clickable="true"
    android:focusable="true"
    android:gravity="center_vertical"
    android:orientation="horizontal"
    android:paddingStart="10dp"
    android:paddingTop="6dp"
    android:paddingEnd="10dp"
    android:paddingBottom="6dp">

    <ImageView
        android:id="@+id/app_icon_iv"
        android:layout_width="30dp"
        android:layout_height="30dp"
        android:importantForAccessibility="no" />

    <LinearLayout
        android:layout_width="0dp"
        android:layout_height="wrap_content"
        android:layout_marginStart="10dp"
        android:layout_weight="1"
        android:orientation="vertical">

        <TextView
            android:id="@+id/app_name_tv"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:ellipsize="end"
            android:singleLine="true"
            android:textColor="@color/glass_text_primary"
            android:textFontWeight="500"
            android:textSize="12.5sp" />

        <TextView
            android:id="@+id/app_time_tv"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:ellipsize="end"
            android:singleLine="true"
            android:textColor="@color/glass_text_secondary"
            android:textSize="11.5sp" />
    </LinearLayout>
</LinearLayout>
