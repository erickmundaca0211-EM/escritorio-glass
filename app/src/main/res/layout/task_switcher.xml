<?xml version="1.0" encoding="utf-8"?>
<!--
    Window switcher (Alt+Tab and the taskbar's Task view button): one glass card in the middle of the
    screen with the open windows' icons in a row, most recently used first, and the selected one's name.
-->
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="wrap_content"
    android:layout_height="wrap_content"
    android:orientation="vertical">

    <LinearLayout
        android:id="@+id/switcher_card"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:background="@drawable/round_rect"
        android:gravity="center_horizontal"
        android:minWidth="220dp"
        android:orientation="vertical"
        android:paddingStart="14dp"
        android:paddingTop="14dp"
        android:paddingEnd="14dp"
        android:paddingBottom="12dp">

        <HorizontalScrollView
            android:id="@+id/switcher_scroll"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:overScrollMode="never"
            android:scrollbars="none">

            <LinearLayout
                android:id="@+id/switcher_items"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:orientation="horizontal" />
        </HorizontalScrollView>

        <TextView
            android:id="@+id/switcher_label"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginTop="10dp"
            android:ellipsize="end"
            android:maxWidth="360dp"
            android:singleLine="true"
            android:textColor="@color/glass_text_primary"
            android:textFontWeight="600"
            android:textSize="14sp" />
    </LinearLayout>
</LinearLayout>
