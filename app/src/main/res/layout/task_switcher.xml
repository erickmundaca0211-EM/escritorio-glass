<?xml version="1.0" encoding="utf-8"?>
<!--
    Window switcher (Alt+Tab and the taskbar's Task view button): one glass card in the middle of the
    screen with the open windows' icons in a row, most recently used first, and the selected one's name.
    The card and the row do not clip their children, so an icon thrown up or down (to close its window)
    can leave the row; TaskSwitcher still clips the row sideways when it scrolls.
-->
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="wrap_content"
    android:layout_height="wrap_content"
    android:orientation="vertical">

    <LinearLayout
        android:id="@+id/switcher_card"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:background="@drawable/round_rect"
        android:clipChildren="false"
        android:clipToPadding="false"
        android:gravity="center_horizontal"
        android:minWidth="220dp"
        android:orientation="vertical"
        android:paddingStart="14dp"
        android:paddingTop="14dp"
        android:paddingEnd="14dp"
        android:paddingBottom="12dp">

        <HorizontalScrollView
            android:id="@+id/switcher_scroll"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:clipChildren="false"
            android:overScrollMode="never"
            android:scrollbars="none">

            <LinearLayout
                android:id="@+id/switcher_items"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:orientation="horizontal" />
        </HorizontalScrollView>

        <TextView
            android:id="@+id/switcher_label"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginTop="10dp"
            android:ellipsize="end"
            android:maxWidth="360dp"
            android:singleLine="true"
            android:textColor="@color/glass_text_primary"
            android:textFontWeight="600"
            android:textSize="14sp" />

        <!-- Close all: only when windows can be closed (Shizuku) -->
        <LinearLayout
            android:id="@+id/switcher_close_all"
            android:layout_width="wrap_content"
            android:layout_height="32dp"
            android:layout_marginTop="10dp"
            android:background="@drawable/task_switcher_close_all_bg"
            android:contentDescription="@string/task_switcher_close_all"
            android:gravity="center_vertical"
            android:orientation="horizontal"
            android:paddingStart="10dp"
            android:paddingEnd="14dp"
            android:visibility="gone">

            <ImageView
                android:layout_width="14dp"
                android:layout_height="14dp"
                android:importantForAccessibility="no"
                android:src="@drawable/ic_eg_close" />

            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginStart="6dp"
                android:importantForAccessibility="no"
                android:text="@string/task_switcher_close_all"
                android:textColor="@color/glass_text_primary"
                android:textSize="13sp" />
        </LinearLayout>
    </LinearLayout>
</LinearLayout>
