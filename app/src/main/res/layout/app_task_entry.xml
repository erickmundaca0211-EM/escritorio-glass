<?xml version="1.0" encoding="utf-8"?>
<!-- Taskbar app button (docs/DISENO.md): 44x42 dp, 28 dp icon, open/active pill at the bottom. -->
<FrameLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="44dp"
    android:layout_height="42dp"
    android:layout_marginStart="1dp"
    android:layout_marginEnd="1dp"
    android:background="@drawable/taskbar_button_bg"
    android:clickable="true"
    android:focusable="true">

    <ImageView
        android:id="@+id/icon_iv"
        android:layout_width="28dp"
        android:layout_height="28dp"
        android:layout_gravity="center"
        android:layout_marginBottom="2dp"
        android:src="@android:drawable/ic_delete" />

    <TextView
        android:id="@+id/task_count_badge"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_gravity="top|end"
        android:alpha="0"
        android:background="@drawable/circle"
        android:elevation="3dp"
        android:padding="2dp"
        android:textSize="9sp" />

    <View
        android:id="@+id/running_indicator"
        android:layout_width="6dp"
        android:layout_height="3dp"
        android:layout_gravity="bottom|center_horizontal"
        android:layout_marginBottom="2dp"
        android:alpha="0"
        android:background="@drawable/taskbar_indicator" />
</FrameLayout>
