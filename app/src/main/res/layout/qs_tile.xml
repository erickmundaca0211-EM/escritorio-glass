<?xml version="1.0" encoding="utf-8"?>
<!-- One quick settings button: 44 dp tall button and its label underneath (11.5). -->
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="0dp"
    android:layout_height="wrap_content"
    android:layout_weight="1"
    android:gravity="center_horizontal"
    android:orientation="vertical">

    <FrameLayout
        android:id="@+id/tile_button"
        android:layout_width="match_parent"
        android:layout_height="44dp"
        android:background="@drawable/qs_tile_bg"
        android:clickable="true"
        android:focusable="true">

        <ImageView
            android:id="@+id/tile_icon"
            android:layout_width="20dp"
            android:layout_height="20dp"
            android:layout_gravity="center"
            android:importantForAccessibility="no" />
    </FrameLayout>

    <TextView
        android:id="@+id/tile_label"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="6dp"
        android:ellipsize="end"
        android:gravity="center_horizontal"
        android:importantForAccessibility="no"
        android:singleLine="true"
        android:textColor="@color/glass_text_primary"
        android:textSize="11.5sp" />
</LinearLayout>
