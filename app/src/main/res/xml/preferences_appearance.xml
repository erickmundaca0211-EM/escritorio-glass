<PreferenceScreen xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto">
    <PreferenceCategory android:title="@string/general">
        <Preference
            android:key="dock_layout"
            android:title="@string/dock_layout" />

        <ListPreference
            android:defaultValue="glass"
            android:entries="@array/themes"
            android:entryValues="@array/theme_values"
            android:key="theme"
            android:title="@string/theme_title"
            app:useSimpleSummaryProvider="true" />

        <Preference
            android:key="theme_main_color"
            android:summary="@string/theme_main_color_summary"
            android:title="@string/theme_main_color_title" />

        <ListPreference
            android:defaultValue="circle"
            android:entries="@array/icon_shapes"
            android:entryValues="@array/icon_shapes_values"
            android:key="icon_shape"
            android:title="@string/icon_shape_title" />

        <SwitchPreferenceCompat
            android:defaultValue="true"
            android:key="single_line_labels"
            android:title="@string/single_line_labels" />
    </PreferenceCategory>

    <!-- Escritorio Glass: glass look (docs/DISENO.md). Read by GlassSettings. -->
    <PreferenceCategory android:title="@string/glass_category">
        <ListPreference
            android:defaultValue="standard"
            android:entries="@array/glass_quality_entries"
            android:entryValues="@array/glass_quality_values"
            android:key="glass_quality"
            android:title="@string/glass_quality_title"
            app:useSimpleSummaryProvider="true" />

        <SeekBarPreference
            android:defaultValue="62"
            android:key="glass_tint_opacity"
            android:max="85"
            android:title="@string/glass_tint_title"
            app:min="35"
            app:showSeekBarValue="true"
            app:updatesContinuously="true" />

        <SeekBarPreference
            android:defaultValue="24"
            android:key="glass_blur_radius"
            android:max="40"
            android:title="@string/glass_blur_title"
            app:min="0"
            app:showSeekBarValue="true" />

        <ListPreference
            android:defaultValue="#6CC4FF"
            android:entries="@array/glass_accent_entries"
            android:entryValues="@array/glass_accent_values"
            android:key="glass_accent"
            android:title="@string/glass_accent_title"
            app:useSimpleSummaryProvider="true" />

        <Preference
            android:enabled="false"
            android:selectable="false"
            android:summary="@string/glass_quality_summary" />
    </PreferenceCategory>

    <!-- Escritorio Glass: desktop behaviour (docs/PLAN.md, Fase 5). Read by DesktopScale and DockService. -->
    <PreferenceCategory android:title="@string/desktop_category">
        <SeekBarPreference
            android:defaultValue="100"
            android:key="app_scale"
            android:max="100"
            android:summary="@string/app_scale_summary"
            android:title="@string/app_scale_title"
            app:min="50"
            app:showSeekBarValue="true" />

        <SwitchPreferenceCompat
            android:defaultValue="true"
            android:key="autohide_fullscreen"
            android:summary="@string/autohide_fullscreen_summary"
            android:title="@string/autohide_fullscreen_title" />

        <SwitchPreferenceCompat
            android:defaultValue="true"
            android:key="block_system_shade"
            android:summary="@string/block_system_shade_summary"
            android:title="@string/block_system_shade_title" />

        <SwitchPreferenceCompat
            android:defaultValue="true"
            android:key="shizuku_reminder"
            android:summary="@string/shizuku_reminder_summary"
            android:title="@string/shizuku_reminder_title" />
    </PreferenceCategory>

    <PreferenceCategory android:title="@string/dock">
        <SwitchPreferenceCompat
            android:key="override_dock_background_alpha"
            android:title="@string/override_dock_background_opacity" />

        <cu.axel.smartdock.preferences.SliderPreference
            android:defaultValue="255"
            android:dependency="override_dock_background_alpha"
            android:key="dock_background_alpha"
            android:title="@string/dock_background_opacity" />

        <SwitchPreferenceCompat
            android:defaultValue="false"
            android:key="round_dock"
            android:title="@string/round_dock" />

        <SwitchPreferenceCompat
            android:defaultValue="false"
            android:key="tint_indicators"
            android:title="@string/tint_indicators_title" />
    </PreferenceCategory>
</PreferenceScreen>
