    <string name="shizuku_install_title">Instala Shizuku</string>
    <string name="shizuku_install_body">Escritorio Glass usa Shizuku para ver las ventanas abiertas, cerrarlas y apagar la cortina del sistema. Es gratuita y de código abierto, y solo tiene estos permisos mientras la mantengas iniciada.</string>
