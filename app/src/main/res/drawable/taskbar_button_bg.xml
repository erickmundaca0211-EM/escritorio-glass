<?xml version="1.0" encoding="utf-8"?>
<!--
    Taskbar button: ripple on press; a soft rounded highlight that fades in when the mouse is over it
    (like Windows 11) and stays, a little stronger, while activated (open menu / active app).
-->
<ripple xmlns:android="http://schemas.android.com/apk/res/android"
    android:color="#33FFFFFF">
    <item android:id="@android:id/mask">
        <shape android:shape="rectangle">
            <corners android:radius="@dimen/glass_radius_button" />
            <solid android:color="#FFFFFFFF" />
        </shape>
    </item>
    <item>
        <selector
            android:enterFadeDuration="120"
            android:exitFadeDuration="180">
            <item
                android:state_activated="true"
                android:state_hovered="true">
                <shape android:shape="rectangle">
                    <corners android:radius="@dimen/glass_radius_button" />
                    <solid android:color="@color/glass_surface_hover_strong" />
                </shape>
            </item>
            <item android:state_activated="true">
                <shape android:shape="rectangle">
                    <corners android:radius="@dimen/glass_radius_button" />
                    <solid android:color="@color/glass_surface_hover" />
                </shape>
            </item>
            <item android:state_hovered="true">
                <shape android:shape="rectangle">
                    <corners android:radius="@dimen/glass_radius_button" />
                    <solid android:color="@color/glass_surface_hover_soft" />
                </shape>
            </item>
            <item>
                <color android:color="@android:color/transparent" />
            </item>
        </selector>
    </item>
</ripple>
