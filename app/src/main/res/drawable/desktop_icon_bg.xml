<?xml version="1.0" encoding="utf-8"?>
<!--
    Highlight of a desktop icon, like Windows: a soft light square under the mouse and a stronger one,
    with a thin edge, while pressed or chosen with the keyboard.
-->
<selector xmlns:android="http://schemas.android.com/apk/res/android"
    android:enterFadeDuration="90"
    android:exitFadeDuration="120">
    <item android:state_pressed="true">
        <shape android:shape="rectangle">
            <corners android:radius="6dp" />
            <solid android:color="@color/glass_surface_hover_strong" />
            <stroke
                android:width="1dp"
                android:color="@color/glass_separator" />
        </shape>
    </item>
    <item android:state_focused="true">
        <shape android:shape="rectangle">
            <corners android:radius="6dp" />
            <solid android:color="@color/glass_surface_hover" />
            <stroke
                android:width="1dp"
                android:color="@color/glass_separator" />
        </shape>
    </item>
    <item android:state_hovered="true">
        <shape android:shape="rectangle">
            <corners android:radius="6dp" />
            <solid android:color="@color/glass_surface_hover" />
        </shape>
    </item>
    <item android:drawable="@android:color/transparent" />
</selector>
