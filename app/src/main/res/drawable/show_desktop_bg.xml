<?xml version="1.0" encoding="utf-8"?>
<!--
    Show desktop button at the far end of the taskbar: a thin line marks it, and it lights up like the
    other taskbar buttons under the mouse or the finger.
-->
<layer-list xmlns:android="http://schemas.android.com/apk/res/android">
    <item android:drawable="@drawable/taskbar_button_bg" />
    <item
        android:width="1dp"
        android:height="20dp"
        android:gravity="start|center_vertical">
        <shape android:shape="rectangle">
            <solid android:color="@color/glass_surface_hover_strong" />
        </shape>
    </item>
</layer-list>
